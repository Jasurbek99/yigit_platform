Table export.SheetRowUserPermission {
  Note: '''
Per-user extra grant for a SheetRowSetting.

When is_locked=True, users listed here with can_edit=True are exceptions
to the lock (ADR-0001). When is_locked=False, they gain regular edit access.

Soft-deleted entries (deleted_at set) are ignored by permission checks.
User FK uses SET_NULL so history is preserved when a user account is
deleted (ADR-0002). The partial UniqueConstraint prevents duplicate active
grants but allows multiple soft-deleted rows (MSSQL filtered index).

DDL: export_sheet_row_user_permission


*table: public.export_sheet_row_user_permission*'''

  id big_auto [note: '''*ID*''', pk, unique, not null]
  row_id big_auto [not null]
  user_id big_auto [null]
  can_edit boolean [note: '''
*can edit*
When False, this is a read-only grant (reserved for future use).''', default:`True`, not null]
  deleted_at date_time [note: '''*deleted at*''', null]
  deleted_by_id big_auto [null]
  created_at date_time [note: '''*created at*''', not null]
  created_by_id big_auto [null]

  indexes {
    (created_by_id) [name: 'export_sheet_row_user_permission_created_by_id_3a055c9a', type: btree]
    (deleted_at) [name: 'export_sheet_row_user_permission_deleted_at_c418a6a4', type: btree]
    (deleted_by_id) [name: 'export_sheet_row_user_permission_deleted_by_id_6543971b', type: btree]
    (id) [pk, unique, name: 'export_sheet_row_user_permission_pkey', type: btree]
    (row_id) [name: 'export_sheet_row_user_permission_row_id_b0536545', type: btree]
    (user_id) [name: 'export_sheet_row_user_permission_user_id_6af2b1a6', type: btree]
  }
}
