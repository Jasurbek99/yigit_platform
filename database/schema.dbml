Table export.SheetRowSetting {
  Note: '''
Per-row configuration for the shipment Sheet view (Sheet Control v2).

Controls display order, visibility, lock state, localized labels/descriptions,
style, and permission triggers for each row in the Shipment Sheet.

Identity:
``field_key`` is the canonical immutable identifier — it matches values
in DEFAULT_SHEET_ROWS and serializer field names. Never change it after
creation.

Permission model (ADR-0001, ADR-0010):
- is_locked=False → triggered_user/roles/extra_users each independently
grant edit access (AND with field perm).
- is_locked=True  → only users in role_triggers or user_permissions
(can_edit=True, not soft-deleted) may edit. Superuser/admin/director
always bypass.

Concurrency (ADR-0006):
``version`` is incremented on every save(). PATCH endpoints must supply
the current version; mismatch → 409 Conflict.

Soft-delete (ADR-0002):
``deleted_at`` / ``deleted_by`` mark deletion. Use objects.active()
for all application queries.

Display order (ADR-0007):
Sparse integers starting at 1024 with step 1024. Drag-reorder updates
a single row's display_order. Rebalance happens only when gap < 2.

DDL: export_sheet_row_setting (no SQL schema prefix — platform table)


*table: public.export_sheet_row_setting*'''

  id big_auto [note: '''*ID*''', pk, unique, not null]
  field_key char [note: '''
*field key*
Matches field_key in DEFAULT_SHEET_ROWS. Immutable after creation.''', unique, not null]
  row_number positive_small_integer [note: '''
*row number*
Original display ordinal from DEFAULT_SHEET_ROWS. Superseded by display_order.''', not null]
  display_order positive_integer [note: '''
*display order*
Sparse integer (step 1024). Controls row order in Sheet view.''', default:`0`, not null]
  is_visible boolean [note: '''
*is visible*
Hidden rows are excluded from the /sheet/ payload entirely.''', default:`True`, not null]
  is_locked boolean [note: '''
*is locked*
When True, only users in role_triggers or active user_permissions may edit. Superuser/admin/director bypass this lock always.''', default:`False`, not null]
  label_tk char [note: '''
*label tk*
Row label in Turkmen. Fallback: i18n file → field_key raw.''', not null]
  label_ru char [note: '''
*label ru*
Row label in Russian.''', not null]
  label_en char [note: '''
*label en*
Row label in English.''', not null]
  who_tk char [note: '''
*who tk*
\"Who\" column override in Turkmen. Falls back to default_who_key i18n.''', not null]
  who_ru char [note: '''
*who ru*
\"Who\" column override in Russian.''', not null]
  who_en char [note: '''
*who en*
\"Who\" column override in English.''', not null]
  description_tk char [note: '''
*description tk*
Tooltip description in Turkmen.''', not null]
  description_ru char [note: '''
*description ru*
Tooltip description in Russian.''', not null]
  description_en char [note: '''
*description en*
Tooltip description in English.''', not null]
  style_width positive_small_integer [note: '''
*style width*
Column width in pixels. Valid range: 50–500.''', null]
  style_align export.char_sheetrowsetting_style_align [note: '''
*style align*
Text alignment: "left", "center", or "right".''', not null]
  style_color char [note: '''
*style color*
Background colour as #RRGGBB hex string.''', not null]
  style_font_color char [note: '''
*style font color*
Cell text colour as #RRGGBB hex string. Applied to value text inside this row"s data cells across all shipments. Overrides the auto WCAG-contrast color picked from the cell background.''', not null]
  style_font_weight export.char_sheetrowsetting_style_font_weight [note: '''
*style font weight*
Cell text weight. Blank = bold (the sheet default). Set "normal" to un-bold this row"s data cells.''', not null]
  style_font_style export.char_sheetrowsetting_style_font_style [note: '''
*style font style*
Cell text style. Blank = upright. Set "italic" to italicize this row"s data cells.''', not null]
  style_font_family export.char_sheetrowsetting_style_font_family [note: '''
*style font family*
Cell text font-family key (dm_sans/inter/mono/serif). Blank = inherit the sheet default font.''', not null]
  style_font_size positive_small_integer [note: '''
*style font size*
Cell text font size in pixels (scaled by zoom on render). Valid range: 8–28. Null = inherit the sheet default (11px).''', null]
  triggered_user_id big_auto [null]
  version positive_integer [note: '''
*version*
Incremented on every save(). Used for optimistic locking in PATCH.''', default:`1`, not null]
  deleted_at date_time [note: '''
*deleted at*
Set to now() on soft-delete. Null = active.''', null]
  deleted_by_id big_auto [null]
  is_custom boolean [note: '''
*is custom*
True for admin-created runtime rows (Phase 5c). Values stored in ShipmentCustomFieldValue, not on Shipment.''', default:`False`, not null]
  hidden_at date_time [note: '''
*hidden at*
Timestamp of the most recent is_visible=False transition. Null when is_visible=True (or never hidden).''', null]
  updated_at date_time [note: '''*updated at*''', not null]
  updated_by_id big_auto [null]

  indexes {
    (deleted_at) [name: 'export_sheet_row_setting_deleted_at_f0226b9e', type: btree]
    (deleted_by_id) [name: 'export_sheet_row_setting_deleted_by_id_ba88f3ce', type: btree]
    (display_order) [name: 'export_sheet_row_setting_display_order_2e255278', type: btree]
    (field_key) [unique, name: 'export_sheet_row_setting_field_key_key', type: btree]
    (hidden_at) [name: 'export_sheet_row_setting_hidden_at_ab4a8636', type: btree]
    (is_custom) [name: 'export_sheet_row_setting_is_custom_94021b8c', type: btree]
    (id) [pk, unique, name: 'export_sheet_row_setting_pkey', type: btree]
    (triggered_user_id) [name: 'export_sheet_row_setting_triggered_user_id_69429eac', type: btree]
    (updated_by_id) [name: 'export_sheet_row_setting_updated_by_id_7cb926cf', type: btree]
  }
}
