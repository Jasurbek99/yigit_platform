Table greenhouse.HarvestDayEntry {
  Note: '''
One row per (weekly_plan, entry_date) carrying plan/forecast/actual values.

Replaces the 12 wide columns on WeeklyHarvestPlan. Each cell in the 15-block × 6-day
grid maps to exactly one HarvestDayEntry row.

Empty-vs-zero semantics:
- value IS NULL → "not entered" (render as em-dash).
- value = 0 AND *_submitted_at IS NOT NULL → explicit confirmed zero (italic style).

Plan state is computed from the submission time relative to GreenhouseConfig deadlines:
on_time / late / critical_late.

Forecast window identifies which time slot the forecast was entered in:
primary / fallback / same_day_red_flag. None means locked (after same_day_close).

DDL: export.harvest_day_entries
UNIQUE: (weekly_plan, entry_date)


*table: public.export_harvest_day_entries*'''

  id big_auto [note: '''*ID*''', pk, unique, not null]
  weekly_plan_id big_auto [not null]
  season_id big_auto [not null]
  block_id big_auto [not null]
  entry_date date [note: '''
*entry date*
Local date (Asia/Ashgabat) this entry covers.''', not null]
  weekday positive_small_integer [note: '''
*weekday*
0=Mon … 6=Sun. Sunday is allowed for end-of-season harvesting.''', not null]
  plan_value decimal [note: '''
*plan value*
Planned harvest kg. NULL = not entered.''', null]
  plan_submitted_at date_time [note: '''
*plan submitted at*
UTC timestamp when plan_value was submitted.''', null]
  plan_submitted_by_id big_auto [null]
  plan_state greenhouse.char_harvestdayentry_plan_state [note: '''
*plan state*
Timeliness of plan submission relative to config deadlines.''', default:`""`, not null]
  forecast_value decimal [note: '''
*forecast value*
Forecast harvest kg. NULL = not entered.''', null]
  forecast_submitted_at date_time [note: '''*forecast submitted at*''', null]
  forecast_submitted_by_id big_auto [null]
  forecast_window greenhouse.char_harvestdayentry_forecast_window [note: '''
*forecast window*
Which time window the forecast was submitted in.''', default:`""`, not null]
  forecast_revision_count positive_small_integer [note: '''
*forecast revision count*
Number of times the forecast value has been revised (first entry = 0).''', default:`0`, not null]
  actual_value decimal [note: '''
*actual value*
Actual harvest kg. NULL = not yet recorded.''', null]
  actual_finalized_at date_time [note: '''*actual finalized at*''', null]
  actual_source greenhouse.char_harvestdayentry_actual_source [note: '''
*actual source*
How actual_value was set. shipment_rollup is the daily computed source; admin_override marks a value the rollup must leave alone.''', default:`""`, not null]
  yesterday_rest_value decimal [note: '''
*yesterday rest value*
Düýnki galyndy — remainder carried over from the previous day (kg). NULL = not entered.''', null]
  daily_note char [note: '''
*daily note*
Bellik — freeform daily-board note (Cyrillic/Latin mixed).''', default:`""`, not null]
  daily_entered_at date_time [note: '''
*daily entered at*
UTC timestamp of the last daily-board write (Girizilen senesi).''', null]
  daily_entered_by_id big_auto [null]
  last_override_at date_time [note: '''*last override at*''', null]
  last_override_by_id big_auto [null]
  last_override_reason char [note: '''
*last override reason*
Most-recent admin override reason (Cyrillic/Latin mixed).''', default:`""`, not null]
  created_at date_time [note: '''*created at*''', not null]
  updated_at date_time [note: '''*updated at*''', not null]

  indexes {
    (block_id) [name: 'export_harvest_day_entries_block_id_817eea63', type: btree]
    (daily_entered_by_id) [name: 'export_harvest_day_entries_daily_entered_by_id_dd1c4809', type: btree]
    (forecast_submitted_by_id) [name: 'export_harvest_day_entries_forecast_submitted_by_id_e6be354d', type: btree]
    (last_override_by_id) [name: 'export_harvest_day_entries_last_override_by_id_1444cd2f', type: btree]
    (id) [pk, unique, name: 'export_harvest_day_entries_pkey', type: btree]
    (plan_submitted_by_id) [name: 'export_harvest_day_entries_plan_submitted_by_id_8ef67b25', type: btree]
    (season_id) [name: 'export_harvest_day_entries_season_id_5ca58ade', type: btree]
    (weekly_plan_id) [name: 'export_harvest_day_entries_weekly_plan_id_78d64f12', type: btree]
    (block_id,entry_date) [name: 'ix_hde_block_date', type: btree]
    (entry_date) [name: 'ix_hde_date', type: btree]
    (season_id,entry_date) [name: 'ix_hde_season_date', type: btree]
  }
}
ref: greenhouse.HarvestDayEntry.weekly_plan_id > greenhouse.WeeklyHarvestPlan.id
ref: greenhouse.HarvestDayEntry.season_id > core.Season.id
ref: greenhouse.HarvestDayEntry.block_id > core.GreenhouseBlock.id
