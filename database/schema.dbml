Table contracts.Contract {
  Note: '''
A signed sale agreement for one season between an export firm (seller) and import firm (buyer).

Denormalized totals (exported_trucks, exported_quantity_kg, exported_amount_usd,
payment_received_usd, remaining_usd) are written ONLY by the rollup service
(``contracts.services.rollup.rollup_contract_totals``), never edited directly.
Until Slice B introduces the rollup service, ``remaining_usd`` is kept consistent
in ``save()`` as a placeholder calculation.

Status flow: active → completed → closed → cancelled.


*table: public.contracts_contract*'''

  id big_auto [note: '''*ID*''', pk, unique, not null]
  contract_number char [note: '''*contract number*''', unique, not null]
  seq integer [note: '''*seq*''', null]
  contract_year integer [note: '''*contract year*''', null]
  season_id big_auto [null]
  export_firm_id big_auto [not null]
  import_firm_id big_auto [not null]
  customer_id big_auto [null]
  contract_type contracts.char_contract_contract_type [note: '''*contract type*''', default:`"FRAMEWORK"`, not null]
  passport_sdelka char [note: '''*passport sdelka*''', default:`""`, not null]
  incoterm char [note: '''*incoterm*''', default:`""`, not null]
  start_date date [note: '''*start date*''', null]
  end_date date [note: '''*end date*''', null]
  planned_trucks integer [note: '''*planned trucks*''', null]
  planned_quantity_kg decimal [note: '''*planned quantity kg*''', null]
  planned_amount_usd decimal [note: '''*planned amount usd*''', null]
  exported_trucks integer [note: '''*exported trucks*''', default:`0`, not null]
  exported_quantity_kg decimal [note: '''*exported quantity kg*''', default:`0`, not null]
  exported_amount_usd decimal [note: '''*exported amount usd*''', default:`0`, not null]
  payment_received_usd decimal [note: '''*payment received usd*''', default:`0`, not null]
  remaining_usd decimal [note: '''*remaining usd*''', default:`0`, not null]
  last_invoice_number integer [note: '''*last invoice number*''', null]
  sent_to_unk boolean [note: '''*sent to unk*''', default:`False`, not null]
  status contracts.char_contract_status [note: '''*status*''', default:`"active"`, not null]
  created_by_id big_auto [null]
  created_at date_time [note: '''*created at*''', not null]
  updated_at date_time [note: '''*updated at*''', not null]

  indexes {
    (contract_number) [unique, name: 'contracts_contract_contract_number_key', type: btree]
    (created_by_id) [name: 'contracts_contract_created_by_id_1552fda4', type: btree]
    (customer_id) [name: 'contracts_contract_customer_id_b91a6462', type: btree]
    (export_firm_id) [name: 'contracts_contract_export_firm_id_04820666', type: btree]
    (import_firm_id) [name: 'contracts_contract_import_firm_id_4588a58a', type: btree]
    (id) [pk, unique, name: 'contracts_contract_pkey', type: btree]
    (season_id) [name: 'contracts_contract_season_id_ec21970c', type: btree]
  }
}
ref: contracts.Contract.season_id > core.Season.id
ref: contracts.Contract.export_firm_id > core.ExportFirm.id
ref: contracts.Contract.import_firm_id > core.ImportFirm.id
ref: contracts.Contract.customer_id > core.Customer.id
ref: contracts.Contract.created_by_id > core.User.id


Table contracts.ContractAttachment {
  Note: '''
A PDF document attached to a contract (signed contract scan, annex, etc.).

File validation (size, extension, magic bytes) is done at the service layer
(``contracts.services.files.validate_contract_document``) before this model
is saved. Files are served only through the authenticated download action on
ContractViewSet — never via a direct /media/ URL — because contract documents
are legal/financial records.


*table: public.contracts_contract_attachment*'''

  id big_auto [note: '''*ID*''', pk, unique, not null]
  contract_id big_auto [not null]
  file file [note: '''*file*''', not null]
  original_filename char [note: '''*original filename*''', not null]
  mime_type char [note: '''*mime type*''', not null]
  size_bytes integer [note: '''*size bytes*''', not null]
  uploaded_by_id big_auto [not null]
  uploaded_at date_time [note: '''*uploaded at*''', not null]

  indexes {
    (contract_id) [name: 'contracts_contract_attachment_contract_id_5d4f10aa', type: btree]
    (id) [pk, unique, name: 'contracts_contract_attachment_pkey', type: btree]
    (uploaded_by_id) [name: 'contracts_contract_attachment_uploaded_by_id_8b21ce7d', type: btree]
  }
}
ref: contracts.ContractAttachment.contract_id > contracts.Contract.id
ref: contracts.ContractAttachment.uploaded_by_id > core.User.id


Table contracts.ContractSale {
  Note: '''
One ContractSale = one export firm's share of a truck (one 2-Sales row),
NOT a whole truck. A truck split across 2-3 firms produces 2-3 rows. Bridged
to the export side by ``(shipment, export_firm)``. See ADR-023.

Denormalized contract totals are updated automatically via
``rollup_contract_totals()`` called from save() and delete().
That function is the single writer of Contract's exported_* fields.

Status flow: draft → sent → paid → void.
Only 'void' is excluded from rollup aggregates; all other statuses count.

NOTE: A proper status-transition endpoint with audit trail is deferred.
Until then, PATCH ``status`` directly is permitted.


*table: public.contracts_contract_sale*'''

  id big_auto [note: '''*ID*''', pk, unique, not null]
  contract_id big_auto [not null]
  shipment_id big_auto [null]
  invoice_number integer [note: '''*invoice number*''', null]
  invoice_date date [note: '''*invoice date*''', null]
  serial_truck_number integer [note: '''*serial truck number*''', null]
  export_firm_id big_auto [null]
  import_firm_id big_auto [null]
  gross_kg decimal [note: '''*gross kg*''', null]
  box_count integer [note: '''*box count*''', null]
  pallet_count decimal [note: '''*pallet count*''', null]
  pallet_weight_kg decimal [note: '''*pallet weight kg*''', null]
  incoterm char [note: '''*incoterm*''', default:`""`, not null]
  quantity_kg decimal [note: '''*quantity kg*''', null]
  price_per_kg decimal [note: '''*price per kg*''', null]
  total_usd decimal [note: '''*total usd*''', null]
  passport_sdelka char [note: '''*passport sdelka*''', default:`""`, not null]
  scan_uploaded boolean [note: '''*scan uploaded*''', default:`False`, not null]
  status contracts.char_contractsale_status [note: '''*status*''', default:`"sent"`, not null]
  created_at date_time [note: '''*created at*''', not null]
  updated_at date_time [note: '''*updated at*''', not null]

  indexes {
    (contract_id) [name: 'contracts_contract_sale_contract_id_f6a91d3c', type: btree]
    (export_firm_id) [name: 'contracts_contract_sale_export_firm_id_3b7f4efc', type: btree]
