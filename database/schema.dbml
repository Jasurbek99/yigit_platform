Table core.GreenhouseConfig {
  Note: '''
Singleton configuration row (pk=1 always) for greenhouse scheduling.

Controls plan-submission deadlines, forecast time windows, notification
lead time, truck capacity, and the bitmask of operating weekdays.

Use GreenhouseConfig.get_solo() to read; never call objects.create()
directly after initial seed.

DDL: core.greenhouse_config


*table: public.core_greenhouse_config*'''

  id big_auto [note: '''*ID*''', pk, unique, not null]
  plan_deadline_weekday positive_small_integer [note: '''
*plan deadline weekday*
ISO weekday by which managers must submit plans (4=Friday).''', default:`4`, not null]
  plan_late_until_weekday positive_small_integer [note: '''
*plan late until weekday*
ISO weekday until which late submissions are accepted (6=Sunday).''', default:`6`, not null]
  plan_critical_late_at_weekday positive_small_integer [note: '''
*plan critical late at weekday*
ISO weekday when plan is considered critically late (0=Monday).''', default:`0`, not null]
  plan_critical_late_at_time time [note: '''
*plan critical late at time*
Local time on plan_critical_late_at_weekday that triggers critical-late.''', default:`00:00:00`, not null]
  forecast_primary_open time [note: '''
*forecast primary open*
Local time when the primary forecast window opens (day-before).''', default:`17:00:00`, not null]
  forecast_primary_close time [note: '''
*forecast primary close*
Local time when the primary forecast window closes (day-before).''', default:`18:00:00`, not null]
  forecast_fallback_close time [note: '''
*forecast fallback close*
Local time of day-of when the fallback window closes.''', default:`09:00:00`, not null]
  forecast_same_day_close time [note: '''
*forecast same day close*
Local time of day-of when the same-day red-flag window closes.''', default:`23:59:00`, not null]
  notification_lead_minutes positive_small_integer [note: '''
*notification lead minutes*
Minutes before a deadline to fire a reminder notification.''', default:`60`, not null]
  truck_capacity_kg decimal [note: '''
*truck capacity kg*
Standard truck capacity in kg; used for Est. Trucks calculation.''', default:`18500`, not null]
  operating_days_bitmask positive_small_integer [note: '''
*operating days bitmask*
Bitmask of operating weekdays: bit 0=Mon … bit 6=Sun. Default 0b0111111 = Mon–Sat.''', default:`63`, not null]
  timezone_name char [note: '''
*timezone name*
IANA timezone name used for local-time window calculations.''', default:`"Asia/Ashgabat"`, not null]
  updated_by_id big_auto [null]
  updated_at date_time [note: '''*updated at*''', not null]

  indexes {
    (id) [pk, unique, name: 'core_greenhouse_config_pkey', type: btree]
    (updated_by_id) [name: 'core_greenhouse_config_updated_by_id_7bcd9f5e', type: btree]
  }
}
ref: core.GreenhouseConfig.updated_by_id > core.User.id


